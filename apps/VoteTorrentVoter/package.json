{
	"name": "votetorrent-voter",
	"version": "0.0.1",
	"private": true,
	"description": "Voter app for casting votes in VoteTorrent elections",
	"scripts": {
		"android": "react-native run-android",
		"ios": "react-native run-ios",
		"lint": "eslint .",
		"start": "react-native start",
		"test": "jest",
		"typecheck": "tsc --noEmit",
		"verify:keystore": "cd android && bundle exec fastlane android verify_keystore",
		"prepare:workspace": "cd android && bundle exec fastlane android prepare",
		"build:debug": "cd android && bundle exec fastlane android build_debug",
		"build:apk": "cd android && bundle exec fastlane android build_apk",
		"build:apk:dev": "cd android && bundle exec fastlane android build_apk_dev",
		"build:aab": "cd android && bundle exec fastlane android build_aab",
		"release:ios:beta": "cd ios && bundle exec fastlane ios beta",
		"release:ios:release": "cd ios && bundle exec fastlane ios release"
	},
	"dependencies": {
		"@libp2p/circuit-relay-v2": "^4",
		"@libp2p/crypto": "^5.1.13",
		"@libp2p/interface": "^3.1.0",
		"@libp2p/websockets": "^10",
		"@multiformats/multiaddr": "^13.0.1",
		"@multiformats/multiaddr-v12": "npm:@multiformats/multiaddr@12.5.1",
		"@noble/curves": "^2",
		"@noble/hashes": "^2",
		"@optimystic/db-core": "^1.7.0",
		"@optimystic/db-p2p": "patch:@optimystic/db-p2p@npm%3A1.7.0#~/.yarn/patches/@optimystic-db-p2p-npm-1.7.0-c1815c4b38.patch",
		"@optimystic/db-p2p-storage-rn": "^1.7.0",
		"@optimystic/quereus-plugin-crypto": "^1.7.0",
		"@optimystic/quereus-plugin-optimystic": "^1.7.0",
		"@quereus/isolation": "^4.20.0",
		"@quereus/plugin-react-native-leveldb": "^4.20.0",
		"@quereus/quereus": "patch:@quereus/quereus@npm%3A4.20.0#~/.yarn/patches/@quereus-quereus-npm-4.20.0-6fd16bc9e5.patch",
		"@quereus/store": "^4.20.0",
		"@react-native-async-storage/async-storage": "^2.1.2",
		"@react-native/gradle-plugin": "^0.78.0",
		"@react-navigation/bottom-tabs": "^7.0.0",
		"@react-navigation/native": "^7.0.0",
		"@react-navigation/native-stack": "^7.0.0",
		"@serfab/cadre-core": "portal:../../vendor/@serfab/cadre-core",
		"@serfab/quereus-plugin-sereus": "portal:../../vendor/@serfab/quereus-plugin-sereus",
		"@ungap/structured-clone": "^1.3.1",
		"@votetorrent/attestation-native": "workspace:*",
		"@votetorrent/ui-web": "workspace:*",
		"@votetorrent/vote-core": "workspace:*",
		"@votetorrent/vote-engine": "workspace:*",
		"buffer": "^6.0.3",
		"event-target-polyfill": "^0.0.4",
		"i18next": "^24.2.2",
		"install": "^0.13.0",
		"react": "19.0.0",
		"react-i18next": "^15.4.1",
		"react-native": "0.78.0",
		"react-native-get-random-values": "^2.0.0",
		"react-native-localize": "^3.4.1",
		"react-native-safe-area-context": "^5.2.0",
		"react-native-screens": "^4.5.0",
		"react-native-splash-view": "^0.0.13",
		"react-native-vector-icons": "^10.0.0",
		"readable-stream": "^4.7.0",
		"rn-leveldb": "^3.11.1",
		"web-streams-polyfill": "^4.3.0"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@babel/preset-env": "^7.25.3",
		"@babel/runtime": "^7.25.0",
		"@react-native-community/cli": "^15.1.0",
		"@react-native-community/cli-platform-android": "^15.1.0",
		"@react-native-community/cli-platform-ios": "^15.1.0",
		"@react-native/babel-preset": "0.78.0",
		"@react-native/eslint-config": "0.78.0",
		"@react-native/metro-config": "0.78.0",
		"@react-native/typescript-config": "0.78.0",
		"@types/jest": "^29.5.13",
		"@types/react": "^19.0.0",
		"@types/react-native-vector-icons": "^6.4.18",
		"@types/react-test-renderer": "^19.0.0",
		"@types/readable-stream": "^4",
		"@types/ungap__structured-clone": "^1",
		"eslint": "^8.19.0",
		"jest": "^29.6.3",
		"prettier": "2.8.8",
		"react-test-renderer": "19.0.0",
		"typescript": "5.0.4"
	},
	"engines": {
		"node": ">=20.19"
	}
}
