{
	"name": "votetorrent-public",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Public, no-login election view for VoteTorrent",
	"scripts": {
		"dev": "vite --port 5181 --strictPort",
		"build": "vite build",
		"build:gate": "vite build --config vite.gate.config.ts",
		"build:mutant": "vite build --config vite.mutant.config.ts",
		"preview": "vite preview --port 5181 --strictPort",
		"test": "yarn test:node",
		"test:node": "node --test --test-concurrency=1 test/node/*.test.mjs",
		"test:browser": "node ../../packages/ui-web/scripts/run-ui-gates.mjs --app . --gate-config vite.gate.config.ts --gate-dist dist-gate --gate-entry election-shell-gate.html --port 5191",
		"gate:prove-no-dedupe": "node ../../packages/ui-web/scripts/run-ui-gates.mjs --app . --gate-config vite.gate.config.ts --gate-dist dist-gate --gate-entry election-shell-gate.html --port 5191 --prove-no-dedupe",
		"gate:prove-token-missing": "node ../../packages/ui-web/scripts/run-ui-gates.mjs --app . --gate-config vite.gate.config.ts --gate-dist dist-gate --gate-entry election-shell-gate.html --port 5191 --prove-token-missing",
		"test:render-fidelity": "node test/browser/render-fidelity-gate.mjs",
		"gate:prove-matchers": "node test/browser/render-fidelity-gate.mjs --prove-matchers",
		"gate:prove-gap-cues-flattened": "node test/browser/render-fidelity-gate.mjs --prove-gap-cues-flattened",
		"test:live-read": "node test/browser/run-live-read-gate.mjs",
		"gate:prove-frozen": "node test/browser/run-live-read-gate.mjs --prove-frozen",
		"typecheck": "tsc --noEmit",
		"assert:no-polyfills": "node scripts/assert-no-node-polyfills.mjs",
		"assert:single-quereus": "node scripts/assert-single-quereus-instance.mjs",
		"assert:libp2p-closure": "node scripts/assert-libp2p-closure.mjs",
		"assert:engine-reach": "node scripts/assert-engine-reach.mjs",
		"assert:no-test-harness-in-dist": "node scripts/assert-no-test-harness-in-dist.mjs",
		"assert:placeholders-labelled": "node scripts/assert-placeholders-labelled.mjs",
		"clean": "rm -rf dist dist-gate node_modules"
	},
	"dependencies": {
		"@libp2p/crypto": "5.1.21",
		"@libp2p/websockets": "10.1.18",
		"@optimystic/db-core": "^0.27.0",
		"@optimystic/db-p2p": "^0.27.0",
		"@optimystic/db-p2p-storage-web": "^0.27.0",
		"@quereus/plugin-indexeddb": "4.18.0",
		"@quereus/quereus": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch",
		"@serfab/cadre-core": "^0.12.0",
		"@serfab/quereus-plugin-sereus": "^0.12.0",
		"@votetorrent/ui-web": "workspace:*",
		"@votetorrent/vote-engine": "workspace:*",
		"@votetorrent/web-data": "workspace:*",
		"react": "19.0.0",
		"react-dom": "19.0.0"
	},
	"devDependencies": {
		"@optimystic/quereus-plugin-crypto": "^0.27.0",
		"@types/node": "^22.10.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^5.0.0",
		"fake-indexeddb": "^6.2.5",
		"playwright": "^1.62.1",
		"typescript": "^5.6.3",
		"vite": "^7.0.0"
	},
	"engines": {
		"node": ">=20.19"
	}
}
