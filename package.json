{
	"name": "votetorrent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"nohoist": [
			"**/react-native",
			"**/react-native/**",
			"**/@react-native/**",
			"**/@react-native-*",
			"**/react-native-*",
			"**/@react-navigation/**",
			"**/react-i18next",
			"**/i18next",
			"**/@babel/**"
		]
	},
	"scripts": {
		"clean": "yarn workspaces foreach -A run clean",
		"build": "yarn workspaces foreach -A run build",
		"lint": "node scripts/check-peer-requirements.mjs && yarn workspaces foreach -A run lint",
		"test": "yarn workspaces foreach -A run test",
		"start": "yarn workspace votetorrent-authority start",
		"android": "yarn workspace votetorrent-authority android",
		"ios": "yarn workspace votetorrent-authority ios",
		"all": "yarn workspace votetorrent-authority ios && yarn workspace votetorrent-authority android",
		"start:voter": "yarn workspace votetorrent-voter start",
		"android:voter": "yarn workspace votetorrent-voter android",
		"ios:voter": "yarn workspace votetorrent-voter ios",
		"all:voter": "yarn workspace votetorrent-voter ios && yarn workspace votetorrent-voter android",
		"lint:peers": "node scripts/check-peer-requirements.mjs",
		"lint:stubs": "bash scripts/lint-stubs.sh",
		"lint:copy": "node scripts/lint-copy.mjs",
		"assert:ui-web-consumers": "node scripts/assert-ui-web-dedupe-and-gate.mjs",
		"verify:security-controls": "node scripts/verify-security-controls.mjs all .planning/phases/52-bootstrap-rendezvous-service",
		"verify:relay-smoke": "node scripts/assert-relay-smoke.mjs",
		"postinstall": "node scripts/check-peer-requirements.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"aegir": "^45.0.8"
	},
	"resolutions": {
		"uint8arrays@npm:^5.0.0": "3.1.1",
		"uint8arrays@npm:^5.0.1": "3.1.1",
		"uint8arrays@npm:^5.0.2": "3.1.1",
		"uint8arrays@npm:^5.1.0": "3.1.1",
		"uuid": "9.0.1",
		"react-native-screens": "4.10.0",
		"@serfab/cadre-core": "^0.12.0",
		"@serfab/quereus-plugin-sereus": "^0.12.0",
		"@serfab/strand-proto": "^0.11.0",
		"@optimystic/db-core": "^0.27.0",
		"@optimystic/db-p2p": "^0.27.0",
		"@optimystic/db-p2p-storage-rn": "^0.27.0",
		"@optimystic/db-p2p-storage-fs": "^0.27.0",
		"@optimystic/db-p2p-storage-web": "^0.27.0",
		"@optimystic/quereus-plugin-optimystic": "^0.27.0",
		"@optimystic/quereus-plugin-crypto": "^0.27.0",
		"@multiformats/multiaddr": "13.0.3",
		"p2p-fret": "^1.0.0-beta.4",
		"@noble/curves": "2.2.0",
		"@noble/hashes": "2.2.0",
		"@noble/ciphers": "2.2.0",
		"@libp2p/crypto": "5.1.21",
		"@libp2p/circuit-relay-v2": "4.2.10",
		"@libp2p/websockets": "10.1.18",
		"@libp2p/peer-id@npm:^6.0.0": "6.0.13",
		"@libp2p/peer-id@npm:^6.0.1": "6.0.13",
		"@libp2p/peer-id@npm:^6.0.4": "6.0.13",
		"@libp2p/peer-id@npm:^6.0.9": "6.0.13",
		"@libp2p/peer-id@npm:^6.0.11": "6.0.13",
		"@libp2p/interface@npm:^3.0.0": "3.2.5",
		"@libp2p/interface@npm:^3.1.0": "3.2.5",
		"@libp2p/interface@npm:^3.2.2": "3.2.5",
		"@libp2p/interface@npm:^3.2.4": "3.2.5",
		"@types/react": "19.2.17",
		"@types/readable-stream": "4.0.24",
		"@ungap/structured-clone": "1.3.3",
		"@quereus/store": "^4.18.0",
		"@quereus/isolation": "^4.18.0",
		"@quereus/quereus": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch",
		"@quereus/quereus@npm:^4.3.0": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch",
		"@quereus/quereus@npm:^4.13.0": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch",
		"@quereus/quereus@npm:^4.14.0": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch",
		"@quereus/quereus@npm:^4.17.1": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch",
		"@quereus/quereus@npm:^4.18.0": "patch:@quereus/quereus@npm%3A4.18.0#~/.yarn/patches/@quereus-quereus-npm-4.18.0-9b9f24c666.patch"
	},
	"packageManager": "yarn@4.7.0",
	"engines": {
		"node": ">=20.19"
	}
}
