{
	"name": "multipeer-gate",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Standalone Node gate for the n=4 Sereus/Optimystic multi-peer topology: 2 always-on relay drones + 2 relay-only peers. Runs five ordered legs (control mesh, relay reservation, cadre authorization, strand cohort, replication) and localizes the first blocker.",
	"scripts": {
		"start": "node multipeer-gate.mjs",
		"gate": "node multipeer-gate.mjs"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@libp2p/circuit-relay-v2": "^4",
		"@libp2p/crypto": "^5",
		"@libp2p/websockets": "^10",
		"@optimystic/db-core": "^1.0.0-beta.3",
		"@optimystic/db-p2p": "^1.0.0-beta.3",
		"@serfab/cadre-core": "0.13.0",
		"@serfab/strand-proto": "^0.11.0"
	},
	"overrides": {
		"@optimystic/db-p2p": "^1.0.0-beta.3",
		"@optimystic/db-core": "^1.0.0-beta.3",
		"@optimystic/quereus-plugin-optimystic": "^1.0.0-beta.3",
		"@optimystic/quereus-plugin-crypto": "^1.0.0-beta.3",
		"@quereus/quereus": "4.18.0",
		"@quereus/store": "4.18.0",
		"@quereus/isolation": "4.18.0"
	}
}
