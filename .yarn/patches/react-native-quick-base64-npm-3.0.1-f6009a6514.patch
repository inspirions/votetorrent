-target_compile_reactnative_options(react_codegen_QuickBase64Spec PRIVATE)
+# VoteTorrent patch (spike 093): this file was generated by React Native >= 0.80 codegen, whose
+# `target_compile_reactnative_options` helper does not exist in RN 0.78's cmake-utils, so the
+# app's CMake configure fails with `Unknown CMake command`. These are the exact flags RN 0.78's
+# own codegen emits for a library module (compare react-native-screens' generated jni).
+target_compile_options(
+  react_codegen_QuickBase64Spec
+  PRIVATE
+  -DLOG_TAG=\"ReactNative\"
+  -fexceptions
+  -frtti
+  -std=c++20
+  -Wall
+)
